# Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives contact form messages
CONTACT_TO=hola@invends.com

# Sender shown in email clients.
# Use onboarding@resend.dev until invends.com is verified in Resend.
CONTACT_FROM=Invends <onboarding@resend.dev>

# Canonical site URL (sitemap, Open Graph, JSON-LD)
NUXT_PUBLIC_SITE_URL=https://invends.com

# Optional: Google Analytics 4 measurement ID (G-XXXXXXXX)
# NUXT_PUBLIC_GA_ID=

# Optional: Google Search Console HTML tag verification content
# NUXT_PUBLIC_GSC_VERIFICATION=

# --- Invends Autonomous SEO Engine ---
# Protects /admin/seo and /api/seo/*
# SEO_DASHBOARD_TOKEN=

# Override crawl target for seo-engine scripts (defaults to NUXT_PUBLIC_SITE_URL)
# SEO_SITE_URL=https://invends.com
# Fallback when custom DNS is not ready (Vercel preview/production URL)
# SEO_FALLBACK_SITE_URL=

# PageSpeed Insights API (optional; improves quota)
# PAGESPEED_API_KEY=

# Google Search Console (service account JSON string or path)
# GSC_SERVICE_ACCOUNT_JSON=
# GSC_SITE_URL=https://invends.com

# Google Analytics Data API
# GA4_PROPERTY_ID=
# GA4_SERVICE_ACCOUNT_JSON=

# Bing Webmaster Tools
# BING_WEBMASTER_API_KEY=

# Shared Google credentials path (alternative)
# GOOGLE_APPLICATION_CREDENTIALS=
